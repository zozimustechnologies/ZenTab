{
  "manifest_version": 3,
  "name": "Zen Tab",
  "version": "1.0.0",
  "description": "A fast, distraction-free new tab page with clock, search, bookmarks, todos, weather, notes, and focus mode.",

  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "storage",
    "topSites",
    "history",
    "alarms",
    "declarativeNetRequest",
    "management"
  ],

  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://nominatim.openstreetmap.org/*"
  ],

  "icons": {
    "16":  "icons/icon-16.png",
    "32":  "icons/icon-32.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_icon": {
      "16":  "icons/icon-16.png",
      "32":  "icons/icon-32.png",
      "48":  "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Zen Tab"
  }
}
